{
  "rules": {
    ".read": false,
    ".write": false,

    "permissions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$deviceId": {
          ".read": "auth != null && (auth.uid === $uid || root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid)",
          ".write": "auth != null && root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid && (newData.child('role').val() === 'member' || !newData.exists() || newData.child('status').val() === 'revoked')",
          "role": {
            ".validate": "newData.val() === 'member'"
          },
          "status": {
            ".validate": "newData.val() === 'active' || newData.val() === 'revoked'"
          }
        }
      }
    },

    "pairing_secrets": {
      ".read": false,
      ".write": false
    },

    "pairing_rate_limits": {
      ".read": false,
      ".write": false
    },

    "devices": {
      "$deviceId": {
        "meta": {
          ".read": "auth != null && (root.child('permissions').child(auth.uid).child($deviceId).child('status').val() === 'active' || auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())",
          ".write": false
        },
        "members": {
          ".read": "auth != null && (root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid || root.child('devices').child($deviceId).child('members').child(auth.uid).child('status').val() === 'active')",
          ".write": "auth != null && root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid",
          "$memberUid": {
            ".read": "auth != null && (root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid || auth.uid === $memberUid)",
            ".write": "auth != null && root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid"
          }
        },
        "live": {
          ".read": "auth != null && (root.child('permissions').child(auth.uid).child($deviceId).child('status').val() === 'active' || auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())",
          ".write": "auth != null && (auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())",
          "voltage": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "current": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "power": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "energy_kwh": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "relay_state": {
            ".validate": "newData.isBoolean()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          }
        },
        "status": {
          ".read": "auth != null && (root.child('permissions').child(auth.uid).child($deviceId).child('status').val() === 'active' || auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())",
          ".write": "auth != null && (auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())"
        },
        "control": {
          ".read": "auth != null && (root.child('permissions').child(auth.uid).child($deviceId).child('status').val() === 'active' || auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())",
          ".write": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).child('status').val() === 'active'",
          "power": {
            ".validate": "newData.isBoolean()"
          },
          "limit_va": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "tariff_per_kwh": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },

    "energy_data": {
      "$deviceId": {
        ".read": "auth != null && (root.child('permissions').child(auth.uid).child($deviceId).child('status').val() === 'active' || auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())",
        ".write": "auth != null && (auth.uid === 'esp32_' + $deviceId || auth.uid === root.child('devices').child($deviceId).child('meta').child('deviceUid').val())"
      }
    }
  }
}
