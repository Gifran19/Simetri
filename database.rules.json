{
  "rules": {
    ".read": false,
    ".write": false,

    "permissions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "pairing_secrets": {
      ".read": false,
      ".write": false
    },

    "pairing_rate_limits": {
      ".read": false,
      ".write": false
    },

    "devices": {
      "$deviceId": {
        "meta": {
          ".read": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).exists()",
          ".write": false
        },
        "live": {
          ".read": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).exists()",
          ".write": false
        },
        "status": {
          ".read": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).exists()",
          ".write": false
        },
        "control": {
          ".read": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).exists()",
          ".write": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).exists()"
        }
      }
    },

    "energy_data": {
      "$deviceId": {
        ".read": "auth != null && root.child('permissions').child(auth.uid).child($deviceId).exists()",
        ".write": false
      }
    }
  }
}
